# Backend
APP_ENV=dev
APP_SECRET=change_me_with_a_random_secret # pour générer un secret aléatoire, utilise cette commande : openssl rand -hex 32
BACKEND_PORT=8000

# MongoDB
MONGODB_DB=ets_booking

# JWT
JWT_SECRET_KEY=/app/config/jwt/private.pem
JWT_PUBLIC_KEY=/app/config/jwt/public.pem
JWT_PASSPHRASE=change_me
JWT_TTL=900

# Cookies
COOKIE_SECURE=false

# CORS : origine du frontend
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1|SERVER_IP)(:[0-9]+)?$

# Frontend : adresse du backend accessible depuis le navigateur
NEXT_PUBLIC_API_URL=http://SERVER_IP:8000/api

# Frontend port
FRONTEND_PORT=3000